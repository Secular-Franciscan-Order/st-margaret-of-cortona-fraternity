{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "franciscan-community-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-01",
  "preview_urls": true,
  "vars": {
    "CONTACT_RECIPIENT": "susan.kowalski@unlv.edu"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "susan.kowalski@unlv.edu",
      "allowed_sender_addresses": [
        "contact@stmargaretofcortona.com"
      ]
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "stmargaretofcortona.endian.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.stmargaretofcortona.com",
      "custom_domain": true
    }
  ]
}
