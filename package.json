{
  "name": "franciscan-community-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "pnpm check:cms && astro check",
    "check:cms": "node scripts/check-cms-content.mjs",
    "check:cms-changes": "node scripts/check-cms-changes.mjs",
    "check:built-site": "node scripts/check-built-site.mjs",
    "check:uploads": "node scripts/check-uploads.mjs",
    "build": "pnpm verify:deploy",
    "verify:deploy": "pnpm check:uploads && pnpm check && astro build && pnpm check:built-site",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "test:worker": "node --experimental-strip-types tests/worker.spec.ts",
    "test:e2e": "playwright test",
    "test:built-site": "node --test tests/built-site.spec.mjs",
    "test:cms": "node --experimental-strip-types --test tests/cms-content.spec.mjs tests/cms-changes.spec.mjs tests/cms-expectations.spec.ts tests/cms-review.spec.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "astro": "7.2.9",
    "marked": "17.0.5",
    "mdast-util-from-markdown": "2.0.3",
    "parse5": "7.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.95.0",
    "yaml": "2.9.0"
  }
}
