---
import PhoneField from "@/components/PhoneField.astro";

const turnstileSiteKey = "0x4AAAAAAEERQmwQp-jP4ygz";
---

<form class="contact-form" action="/api/contact" method="post" novalidate>
  <div class="contact-form__content">
    <div class="contact-form__name-row">
      <div class="contact-form__field">
        <label for="contact-first-name">First Name</label>
        <input
          id="contact-first-name"
          name="first-name"
          type="text"
          maxlength="100"
          autocomplete="given-name"
        />
      </div>

      <div class="contact-form__field">
        <label for="contact-last-name">Last Name</label>
        <input
          id="contact-last-name"
          name="last-name"
          type="text"
          maxlength="100"
          autocomplete="family-name"
        />
      </div>
    </div>

    <div class="contact-form__field">
      <label for="contact-email">Email <span aria-hidden="true">*</span></label>
      <input
        id="contact-email"
        name="email"
        type="email"
        maxlength="250"
        autocomplete="email"
        required
      />
    </div>

    <PhoneField />

    <div class="contact-form__field">
      <label for="contact-message">Message</label>
      <textarea
        id="contact-message"
        name="message"
        maxlength="5000"
        rows="5"
      ></textarea>
    </div>

    <div class="contact-form__honeypot" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input
        id="contact-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-theme="light"
    ></div>

    <div class="contact-form__actions">
      <button class="contact-form__submit" type="submit">
        <span class="contact-form__submit-label">Send message</span>
        <span class="contact-form__submit-pending" aria-hidden="true">
          <span class="contact-form__spinner"></span>
          Sending…
        </span>
      </button>
    </div>

    <p class="contact-form__error" hidden role="alert"></p>
  </div>

  <div class="contact-form__success" hidden tabindex="-1">
    <p class="contact-form__success-copy">We’ll be in touch soon.</p>
    <button class="contact-form__reset" type="button">Send another message</button>
  </div>

  <p class="contact-form__status visually-hidden" aria-live="polite" role="status"></p>
</form>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const resetTurnstile = () =>
    (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();

  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>(
      ".contact-form__submit"
    );
    const formContent = form.querySelector<HTMLDivElement>(
      ".contact-form__content"
    );
    const status = form.querySelector<HTMLParagraphElement>(
      ".contact-form__status"
    );
    const errorMessage = form.querySelector<HTMLParagraphElement>(
      ".contact-form__error"
    );
    const success = form.querySelector<HTMLDivElement>(
      ".contact-form__success"
    );
    const resetButton = form.querySelector<HTMLButtonElement>(
      ".contact-form__reset"
    );

    const setStatus = (message: string) => {
      if (status) status.textContent = message;
    };

    const clearError = () => {
      if (!errorMessage) return;

      errorMessage.hidden = true;
      errorMessage.textContent = "";
    };

    const showError = (message: string) => {
      if (errorMessage) {
        errorMessage.textContent = message;
        errorMessage.hidden = false;
      }
      setStatus("");
    };

    const setSubmitting = (isSubmitting: boolean) => {
      if (submitButton) {
        submitButton.disabled = isSubmitting;
        submitButton.setAttribute(
          "aria-label",
          isSubmitting ? "Sending your message" : "Send message"
        );
      }
      form.dataset.state = isSubmitting ? "sending" : "idle";
      form.setAttribute("aria-busy", String(isSubmitting));
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      clearError();
      const formData = new FormData(form);
      const turnstileToken = formData.get("cf-turnstile-response");

      if (typeof turnstileToken !== "string" || turnstileToken.length === 0) {
        showError("Please complete the verification before sending your message.");
        return;
      }

      setSubmitting(true);
      setStatus("Sending your message…");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" }
        });
        let result: { message?: string } = {};

        try {
          result = (await response.json()) as { message?: string };
        } catch {
          // Use the generic error below if a failed response has no JSON body.
        }

        if (!response.ok) {
          throw new Error(
            result.message ||
              "We could not send your message. Please try again or use the contact details above."
          );
        }

        form.reset();
        resetTurnstile();
        formContent?.setAttribute("hidden", "");
        success?.removeAttribute("hidden");
        success?.focus();
        form.dataset.state = "success";
        setStatus("We’ll be in touch soon.");
      } catch (error) {
        const message =
          error instanceof Error && error.name === "Error"
            ? error.message
            : "We could not send your message. Please try again or use the contact details above.";
        showError(message);
      } finally {
        if (form.dataset.state !== "success") setSubmitting(false);
        else {
          submitButton?.removeAttribute("disabled");
          submitButton?.setAttribute("aria-label", "Send message");
          form.setAttribute("aria-busy", "false");
        }
      }
    });

    resetButton?.addEventListener("click", () => {
      success?.setAttribute("hidden", "");
      formContent?.removeAttribute("hidden");
      form.reset();
      resetTurnstile();
      setSubmitting(false);
      setStatus("");
      clearError();
      form.querySelector<HTMLInputElement>("#contact-first-name")?.focus();
    });
  }
</script>
