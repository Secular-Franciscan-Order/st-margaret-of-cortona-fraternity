---
const turnstileSiteKey = "0x4AAAAAAEERQmwQp-jP4ygz";
---

<form class="contact-form" action="/api/contact" method="post" novalidate>
  <div class="contact-form__name-row">
    <div class="contact-form__field">
      <label for="contact-first-name">First Name</label>
      <input
        id="contact-first-name"
        name="first-name"
        type="text"
        maxlength="100"
        autocomplete="given-name"
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-last-name">Last Name</label>
      <input
        id="contact-last-name"
        name="last-name"
        type="text"
        maxlength="100"
        autocomplete="family-name"
      />
    </div>
  </div>

  <div class="contact-form__field">
    <label for="contact-email">Email <span aria-hidden="true">*</span></label>
    <input
      id="contact-email"
      name="email"
      type="email"
      maxlength="250"
      autocomplete="email"
      required
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-message">Message</label>
    <textarea
      id="contact-message"
      name="message"
      maxlength="5000"
      rows="5"
    ></textarea>
  </div>

  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input
      id="contact-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div
    class="cf-turnstile"
    data-sitekey={turnstileSiteKey}
    data-theme="light"
  ></div>

  <button class="contact-form__submit" type="submit">Send</button>
  <p class="contact-form__status" aria-live="polite" role="status"></p>
</form>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const resetTurnstile = () =>
    (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();

  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>(
      ".contact-form__submit"
    );
    const status = form.querySelector<HTMLParagraphElement>(
      ".contact-form__status"
    );

    const setStatus = (message: string, isError = false) => {
      if (!status) return;

      status.textContent = message;
      status.dataset.state = isError ? "error" : "success";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      const turnstileToken = formData.get("cf-turnstile-response");

      if (typeof turnstileToken !== "string" || turnstileToken.length === 0) {
        setStatus("Please complete the verification before sending your message.", true);
        return;
      }

      submitButton?.setAttribute("disabled", "");
      setStatus("Sending your message…");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" }
        });
        const result = (await response.json()) as { message?: string };

        if (!response.ok) {
          throw new Error(result.message || "We could not send your message.");
        }

        form.reset();
        resetTurnstile();
        setStatus("Thank you. Your message has been sent.");
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : "We could not send your message. Please try again.";
        setStatus(message, true);
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }
</script>
